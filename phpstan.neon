includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Traits here are used by Livewire single-file components, which PHPStan does not analyse.
        -
            identifier: trait.unused
            path: app/Concerns/*
